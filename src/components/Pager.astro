---
// 文章列表底部分页器：上一页 / 下一页 + 页码。
const { page, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL;

const urlFor = (n: number) => (n === 1 ? `${base}blog/` : `${base}blog/${n}/`);
const nums = Array.from({ length: totalPages }, (_, i) => {
  const n = i + 1;
  return { n, url: urlFor(n), current: n === page };
});
const prev = page > 1 ? urlFor(page - 1) : null;
const next = page < totalPages ? urlFor(page + 1) : null;
---

{
  totalPages > 1 && (
    <nav class="pager" aria-label="Pagination">
      {prev ? (
        <a class="pg" href={prev}>
          <span data-lang="en">← Newer</span>
          <span data-lang="zh">← 上一页</span>
        </a>
      ) : (
        <span class="pg pg-disabled">
          <span data-lang="en">← Newer</span>
          <span data-lang="zh">← 上一页</span>
        </span>
      )}

      <div class="pg-nums">
        {nums.map((p) =>
          p.current ? (
            <span class="pg-num pg-current">{p.n}</span>
          ) : (
            <a class="pg-num" href={p.url}>
              {p.n}
            </a>
          )
        )}
      </div>

      {next ? (
        <a class="pg" href={next}>
          <span data-lang="en">Older →</span>
          <span data-lang="zh">下一页 →</span>
        </a>
      ) : (
        <span class="pg pg-disabled">
          <span data-lang="en">Older →</span>
          <span data-lang="zh">下一页 →</span>
        </span>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .pg {
    color: #4f6267;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .pg:hover {
    color: var(--accent);
  }

  .pg-disabled {
    color: #b9c7ca;
    cursor: default;
  }

  .pg-nums {
    display: flex;
    gap: 0.4rem;
  }

  .pg-num {
    min-width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    text-decoration: none;
    color: #4f6267;
    font-weight: 600;
    border: 1px solid #e3ecee;
    background: #ffffff;
  }

  .pg-num:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pg-current {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .pg-current:hover {
    color: #ffffff;
  }
</style>
