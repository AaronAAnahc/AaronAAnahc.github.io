---
const { title = "A-BLOG" } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith("/") ? base : `${base}/`;
const aboutHref = `${homeHref}about/`;
const resumeHref = `${homeHref}resume.pdf`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      html[lang="en"] [data-lang="zh"] { display: none !important; }
      html[lang="zh"] [data-lang="en"] { display: none !important; }

      .lang-switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        padding: 3px;
        border: 1px solid #d7e3e6;
        border-radius: 999px;
        background: #ffffff;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.9rem;
        line-height: 1;
        transition: border-color 0.2s ease;
      }

      .lang-switch:hover {
        border-color: var(--accent);
      }

      .lang-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        width: calc(50% - 3px);
        height: calc(100% - 6px);
        border-radius: 999px;
        background: var(--accent);
        transition: transform 0.25s ease;
      }

      .lang-opt {
        position: relative;
        z-index: 1;
        width: 44px;
        text-align: center;
        padding: 0.42rem 0;
        font-weight: 600;
        color: var(--muted);
        transition: color 0.25s ease;
        pointer-events: none;
      }

      html[lang="zh"] .lang-thumb { transform: translateX(100%); }
      html[lang="en"] .lang-opt[data-val="en"] { color: #ffffff; }
      html[lang="zh"] .lang-opt[data-val="zh"] { color: #ffffff; }
    </style>
    <script is:inline>
      (function () {
        var lang = "en";
        try {
          var saved = localStorage.getItem("lang");
          if (saved === "zh" || saved === "en") lang = saved;
        } catch (e) {}
        document.documentElement.lang = lang;
      })();
    </script>
    <style>
      :root {
        --accent: #39c5bb;
        --accent-light: #d9f4ff;
        --accent-soft: #ffd7e8;
        --text: #152428;
        --muted: #4f6267;
        --bg: #f9fcfd;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Noto Sans JP", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
        color: var(--text);
        background: linear-gradient(180deg, #ffffff 0%, var(--bg) 60%);
        line-height: 1.6;
      }

      .top-accent {
        height: 4px;
        background: linear-gradient(90deg, var(--accent), var(--accent-light), var(--accent-soft));
      }

      header,
      main,
      footer {
        width: min(860px, calc(100% - 2rem));
        margin: 0 auto;
      }

      header {
        padding: 1.2rem 0 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }

      nav a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 500;
      }

      nav a:hover {
        color: var(--accent);
      }

      nav .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-weight: 600;
        font-family: inherit;
        font-size: 0.95rem;
        border: 1px solid transparent;
      }

      nav .btn-gh {
        color: var(--text);
        border-color: #d7e3e6;
        background: #ffffff;
      }

      nav .btn-gh:hover {
        color: var(--accent);
        border-color: var(--accent);
        background: #f0faf9;
      }

      nav .btn-resume {
        color: #ffffff;
        background: var(--accent);
        border-color: var(--accent);
      }

      nav .btn-resume:hover {
        background: #2fb0a7;
        color: #ffffff;
      }

      .brand {
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      main {
        padding: 2.4rem 0 3.5rem;
      }

      footer {
        color: var(--muted);
        border-top: 1px solid #e8eff1;
        padding: 1rem 0 2rem;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <div class="top-accent"></div>
    <header>
      <div class="brand">A-BLOG</div>
      <nav>
        <a href={homeHref}><span data-lang="en">Home</span><span data-lang="zh">首页</span></a>
        <a href={aboutHref}><span data-lang="en">About</span><span data-lang="zh">关于</span></a>
        <a class="btn btn-gh" href="https://github.com/AaronAAnahc" target="_blank" rel="noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          <span data-lang="en">GitHub</span><span data-lang="zh">GitHub</span>
        </a>
        <a class="btn btn-resume" href={resumeHref} target="_blank" rel="noreferrer"><span data-lang="en">Resume</span><span data-lang="zh">简历</span></a>
        <button id="lang-toggle" class="lang-switch" type="button" aria-label="Toggle language / 切换语言"><span class="lang-thumb"></span><span class="lang-opt" data-val="en">EN</span><span class="lang-opt" data-val="zh">中文</span></button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer><span data-lang="en">Built with Astro</span><span data-lang="zh">由 Astro 构建</span></footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("lang-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var next = document.documentElement.lang === "zh" ? "en" : "zh";
          document.documentElement.lang = next;
          try { localStorage.setItem("lang", next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
