---
const { title = "A-BLOG" } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith("/") ? base : `${base}/`;
const aboutHref = `${homeHref}about/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --miku-teal: #39c5bb;
        --miku-blue: #d9f4ff;
        --miku-pink: #ffd7e8;
        --text: #152428;
        --muted: #4f6267;
        --bg: #f9fcfd;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", "Noto Sans JP", "Segoe UI", sans-serif;
        color: var(--text);
        background: linear-gradient(180deg, #ffffff 0%, var(--bg) 60%);
        line-height: 1.6;
      }

      .top-accent {
        height: 4px;
        background: linear-gradient(90deg, var(--miku-teal), var(--miku-blue), var(--miku-pink));
      }

      header,
      main,
      footer {
        width: min(860px, calc(100% - 2rem));
        margin: 0 auto;
      }

      header {
        padding: 1.2rem 0 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      nav a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 1rem;
        font-weight: 500;
      }

      nav a:hover {
        color: var(--miku-teal);
      }

      .brand {
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      main {
        padding: 2.4rem 0 3.5rem;
      }

      footer {
        color: var(--muted);
        border-top: 1px solid #e8eff1;
        padding: 1rem 0 2rem;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <div class="top-accent"></div>
    <header>
      <div class="brand">A-BLOG</div>
      <nav>
        <a href={homeHref}>Home</a>
        <a href={aboutHref}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Built with Astro · Tasteful Miku-inspired palette</footer>
  </body>
</html>
