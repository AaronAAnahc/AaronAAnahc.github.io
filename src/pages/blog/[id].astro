---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  const ids = [...new Set(entries.map((e) => e.data.id))];
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const entries = await getCollection("blog");
const en = entries.find((e) => e.data.id === id && e.data.lang === "en");
const zh = entries.find((e) => e.data.id === id && e.data.lang === "zh");
const meta = en ?? zh;

const enRender = en ? await render(en) : null;
const zhRender = zh ? await render(zh) : null;
const EnContent = enRender?.Content;
const ZhContent = zhRender?.Content;

const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith("/") ? base : `${base}/`;
---

<BaseLayout title={`${meta.data.title} | A-BLOG`}>
  <article class="post">
    <a class="back" href={homeHref}>
      <span data-lang="en">← Back to home</span>
      <span data-lang="zh">← 返回首页</span>
    </a>

    <header class="head">
      <h1><span data-lang="en">{en?.data.title}</span><span data-lang="zh">{zh?.data.title}</span></h1>
      {meta.data.date && <time class="date">{meta.data.date}</time>}
    </header>

    {EnContent && (
      <div class="body" data-lang="en">
        <EnContent />
      </div>
    )}
    {ZhContent && (
      <div class="body" data-lang="zh">
        <ZhContent />
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    color: #4f6267;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .back:hover {
    color: #39c5bb;
  }

  .head {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #e8eff1;
  }

  .head h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
  }

  .date {
    color: #8aa0a5;
    font-size: 0.9rem;
  }

  /* Markdown 正文样式 */
  .body {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #2b3c40;
  }

  .body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.3rem;
    color: #0f3136;
  }

  .body :global(p) {
    margin: 0 0 1rem;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.4rem;
  }

  .body :global(li) {
    margin-bottom: 0.4rem;
  }

  .body :global(strong) {
    color: #152428;
  }

  .body :global(a) {
    color: #39c5bb;
    text-decoration: none;
  }

  .body :global(a:hover) {
    text-decoration: underline;
  }

  .body :global(code) {
    background: #eef5f6;
    color: #0f3136;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .body :global(pre) {
    background: #0f3136;
    color: #dff7f4;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .body :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }
</style>
