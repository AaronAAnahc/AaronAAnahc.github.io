---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogList from "../components/BlogList.astro";
import { getBlogPosts } from "../lib/blog";

const entries = await getCollection("projects");
const ids = [...new Set(entries.map((e) => e.data.id))];
const projects = ids
  .map((id) => {
    const en = entries.find((e) => e.data.id === id && e.data.lang === "en");
    const zh = entries.find((e) => e.data.id === id && e.data.lang === "zh");
    return { id, en, zh };
  })
  .sort((a, b) => (a.en?.data.order ?? 0) - (b.en?.data.order ?? 0));

const posts = await getBlogPosts();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="A-BLOG | Home">
  <section class="hero">
    <h1><span data-lang="en">Aaron</span><span data-lang="zh">陳仲勳</span></h1>
    <p class="intro"><span data-lang="en">This personal site is under construction.</span><span data-lang="zh">个人主页正在紧张施工中</span></p>
  </section>

  <section class="projects">
    <h2><span data-lang="en">Projects</span><span data-lang="zh">项目</span></h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`${base}projects/${p.id}/`}>
          <div class="card-title">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z" />
            </svg>
            <span class="card-name">{p.en?.data.title}</span>
          </div>
          <p class="card-desc"><span data-lang="en">{p.en?.data.subtitle}</span><span data-lang="zh">{p.zh?.data.subtitle}</span></p>
          <div class="card-foot">
            {p.en?.data.tech && <span class="tech">{p.en.data.tech}</span>}
            <span class="more"><span data-lang="en">Read more →</span><span data-lang="zh">阅读详情 →</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="blog">
    <h2><span data-lang="en">Blog</span><span data-lang="zh">博客</span></h2>
    <BlogList posts={posts.slice(0, 5)} />
    <a class="post-all" href={`${base}blog/`}>
      <span data-lang="en">View all posts →</span>
      <span data-lang="zh">查看全部文章 →</span>
    </a>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
  }

  .intro {
    margin: 0;
    max-width: 44ch;
    color: #3f575d;
    font-size: 1.1rem;
  }

  .projects {
    margin-top: 2.75rem;
  }

  .projects h2 {
    font-size: 1.35rem;
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid #e3ecee;
    border-radius: 12px;
    background: #ffffff;
    text-decoration: none;
    color: #152428;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: #39c5bb;
    box-shadow: 0 6px 18px rgba(57, 197, 187, 0.12);
    transform: translateY(-2px);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #0f3136;
  }

  .card-title svg {
    color: #39c5bb;
    flex-shrink: 0;
  }

  .card-name {
    word-break: break-word;
  }

  .card-desc {
    margin: 0;
    color: #4f6267;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .card-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .tech {
    color: #4f6267;
    background: #eef5f6;
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .more {
    color: #39c5bb;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .blog {
    margin-top: 2.75rem;
  }

  .blog h2 {
    font-size: 1.35rem;
    margin: 0 0 1rem;
  }

  .post-all {
    display: inline-block;
    margin-top: 1.1rem;
    color: #39c5bb;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .post-all:hover {
    text-decoration: underline;
  }
</style>
