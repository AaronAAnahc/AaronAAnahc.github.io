---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "MinecraftMod-VillagerAgent",
    url: "https://github.com/AaronAAnahc/MinecraftMod-VillagerAgent",
    lang: "Java",
    langColor: "#b07219",
    desc: {
      en: "AI-powered Minecraft villagers — LLM-driven agents with personalities, memories, and spatial reasoning.",
      zh: "AI 驱动的 Minecraft 村民——大语言模型赋能的智能体，拥有个性、记忆与空间推理能力。",
    },
  },
  {
    name: "FPS-Simulator",
    url: "https://github.com/JamesLiu12/FPS-Simulator",
    lang: "C",
    langColor: "#555555",
    desc: {
      en: "A self-built 3D FPS engine that renders a first-person shooter entirely in the terminal",
      zh: "自建 3D FPS 引擎，在终端里渲染第一人称射击",
    },
  },
  {
    name: "TransKnight",
    url: "https://github.com/AaronAAnahc/TransKnight",
    lang: "Unity C#",
    langColor: "#178600",
    desc: {
      en: "A 2D platformer starring a shape-shifting hero — transform mid-air to unlock new movement and attacks.",
      zh: "主角可变身的 2D 平台跳跃游戏——空中变身解锁全新移动与攻击方式。",
    },
  },
  {
    name: "3DScan",
    url: "https://github.com/AaronAAnahc/3DScan",
    lang: "Unity C#",
    langColor: "#178600",
    desc: {
      en: "A 3D scanning project based on AR that reconstructs real-world objects into digital 3D models using RGB-D.",
      zh: "基于 AR 的 3D 扫描项目，利用 RGB-D 把真实物体重建为数字 3D 模型。",
    },
  },
];
---

<BaseLayout title="A-BLOG | Home">
  <section class="hero">
    <h1><span data-lang="en">Aaron</span><span data-lang="zh">陳仲勳</span></h1>
    <p class="intro"><span data-lang="en">Game developer working on real-time rendering and AI agents.</span><span data-lang="zh">游戏开发者，专注于实时渲染与 AI 智能体。</span></p>
  </section>

  <section class="projects">
    <h2><span data-lang="en">Projects</span><span data-lang="zh">项目</span></h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={p.url} target="_blank" rel="noreferrer">
          <div class="card-title">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z" />
            </svg>
            <span class="card-name">{p.name}</span>
          </div>
          <p class="card-desc"><span data-lang="en">{p.desc.en}</span><span data-lang="zh">{p.desc.zh}</span></p>
          {p.lang && (
            <div class="card-meta">
              <span class="lang-dot" style={`background: ${p.langColor}`}></span>
              <span>{p.lang}</span>
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
  }

  .intro {
    margin: 0;
    max-width: 44ch;
    color: #3f575d;
    font-size: 1.1rem;
  }

  .projects {
    margin-top: 2.75rem;
  }

  .projects h2 {
    font-size: 1.35rem;
    margin: 0 0 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid #e3ecee;
    border-radius: 12px;
    background: #ffffff;
    text-decoration: none;
    color: #152428;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .card:hover {
    border-color: #39c5bb;
    box-shadow: 0 6px 18px rgba(57, 197, 187, 0.12);
    transform: translateY(-2px);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #0f3136;
  }

  .card-title svg {
    color: #39c5bb;
    flex-shrink: 0;
  }

  .card-name {
    word-break: break-word;
  }

  .card-desc {
    margin: 0;
    color: #4f6267;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .card-meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #4f6267;
  }

  .lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
</style>
